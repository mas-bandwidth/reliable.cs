<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net8.0 (LTS) is the floor so game servers on .NET 8 can reference the
         library; net10.0 is the current SDK. Same pair as serialize.cs. -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- family value: zero third-party dependencies. no package references, ever. -->

  <ItemGroup>
    <!-- the C library's tests poke internals (sequence buffer, wire header codecs);
         the mirrored suite and the interop harness get the same access -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Reliable.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Reliable.Compat</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
